# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amana"

# ─── NextAuth v5 ─────────────────────────────────────────────
AUTH_SECRET=""       # run: openssl rand -base64 32

# ─── App URL ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ─── Flutterwave ─────────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=""
FLW_SECRET_HASH=""

# ─── Vesicash ────────────────────────────────────────────────
VESICASH_API_URL="https://sandbox.api.vesicash.com"
VESICASH_PRIVATE_KEY=""

# Customer care — server-only AI credential
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Fulfilment alert for verified-paid South African orders (see docs/order-notifications.md)
ORDER_ALERT_EMAIL=
PAYFAST_FEE_PERCENT=
PAYFAST_FEE_FIXED_CENTS=

# Payfast online payment. Off unless PAYFAST_ENABLED=true and the merchant details are set.
# Start with PAYFAST_MODE=sandbox (sandbox merchant details); live also requires PAYFAST_PASSPHRASE.
PAYFAST_ENABLED="false"
PAYFAST_MODE="sandbox"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
# Public https address Payfast sends customers and notifications back to (defaults to https://plentovo.com).
PAYFAST_SITE_URL=""
