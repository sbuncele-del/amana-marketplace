# Tunisia only. Never reuse the South African database or Shipper credentials.
SHIPPER_NETWORK_API_KEY=
# Legacy variable name is also accepted: TUNISIA_SHIPPER_API_KEY
TUNISIA_SHIPPER_WEBHOOK_SECRET=
TUNISIA_DATABASE_URL=
TUNISIA_ORDERS_ENABLED=false
# Cash-on-delivery ordering opens only when ALL of these are set (and TUNISIA_ORDERS_ENABLED=true):
# a database, a Resend key and verified sender, and the inbox that must call customers to confirm.
RESEND_API_KEY=
TUNISIA_FROM_EMAIL=
TUNISIA_ORDER_ALERT_EMAIL=
# Search engines may index the site only when this is exactly true. Cart, checkout and tracking stay noindex regardless.
TUNISIA_INDEXING=false
