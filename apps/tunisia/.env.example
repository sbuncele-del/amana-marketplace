# Tunisia only. Never reuse the South African database or Shipper credentials.
SHIPPER_NETWORK_API_KEY=
# Legacy variable name is also accepted: TUNISIA_SHIPPER_API_KEY
TUNISIA_SHIPPER_WEBHOOK_SECRET=
TUNISIA_DATABASE_URL=
TUNISIA_ORDERS_ENABLED=false

# --- Catalogue import (see docs/catalogue-import.md) ---
# Secrets for the sync and report routes. Both routes refuse every request until set (16+ characters).
CRON_SECRET=
TUNISIA_ADMIN_TOKEN=
# Connections per server instance (default 3). Keep low on serverless.
TUNISIA_DB_POOL_MAX=
# Provisional pricing for products with no selling price. Off by default; cost is never used as a price.
# When "markup", the markup percentage is required (there is deliberately no default margin).
TUNISIA_PROVISIONAL_PRICING=off
TUNISIA_PROVISIONAL_MARKUP_PCT=
TUNISIA_PROVISIONAL_ROUNDING_MILLIMES=500
TUNISIA_PROVISIONAL_MIN_MARGIN_MILLIMES=1000
# Hold products whose selling price is at or below cost (default true).
TUNISIA_BLOCK_BELOW_COST=true
# Publish machine translations that have not been reviewed (default false).
TUNISIA_PUBLISH_MACHINE_TRANSLATIONS=false
# Only images from these hosts are published.
TUNISIA_IMAGE_HOSTS=cdn.shipper.network
# Background refresh when data is older than this, and the time budget for one sync call.
TUNISIA_SYNC_FRESHNESS_MINUTES=10
TUNISIA_SYNC_BUDGET_SECONDS=45
# Name of a recommended-retail-price field if Shipper adds one to GET /products (none today).
TUNISIA_SHIPPER_RECOMMENDED_FIELD=
# Only for `npm run catalogue:content -- --translate` (optional machine translation of missing languages).
ANTHROPIC_API_KEY=
